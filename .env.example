NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: transactional writes are never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Leave empty to keep manual production planning available.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Server-only. Voice order input uses Realtime over WebRTC.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Optional: invite links should point at the deployed app.
APP_URL=http://localhost:3000
